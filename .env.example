# Neon: conexión pooled (la app) y directa (migraciones de Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Admin
ADMIN_PASSWORD="cambia-esto"
# String aleatorio largo (ej: openssl rand -base64 32)
ADMIN_SESSION_SECRET="cambia-esto-por-un-secreto-largo"

# Cloudflare R2
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_BUCKET="your-bucket-name"
# URL pública del bucket (r2.dev o dominio propio), sin "/" final
NEXT_PUBLIC_R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"
