# Neon: conexión pooled (la app) y directa (migraciones de Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Admin
ADMIN_PASSWORD="cambia-esto"
# String aleatorio largo (ej: openssl rand -base64 32)
ADMIN_SESSION_SECRET="cambia-esto-por-un-secreto-largo"

# Cloudflare R2
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_BUCKET="your-bucket-name"
# URL pública del bucket (r2.dev o dominio propio), sin "/" final
NEXT_PUBLIC_R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# ---------- Saludo de cumpleaños (página principal "/") ----------
# Contraseña que se pide al entrar (sin distinguir mayúsculas)
BIRTHDAY_PASSWORD="nuestra-palabra-secreta"
# Pista opcional que se muestra bajo el candado
BIRTHDAY_PASSWORD_HINT="Nuestra fecha especial (ddmm)"
# Texto sobre el sobre de entrada y título del pastel
BIRTHDAY_TO="Para ti"
BIRTHDAY_TITLE="Feliz cumpleaños"
# Mensaje completo; "||" separa una tarjeta de la siguiente
BIRTHDAY_MESSAGE="Primera tarjeta... || Segunda tarjeta... || Tercera tarjeta..."
# Fotos o videos (.mp4/.webm/.mov, sin sonido) como keys de R2 o URLs, separadas por coma, en el mismo orden que las tarjetas. Deja vacío para una tarjeta sin foto: "a.jpg,,c.jpg"
BIRTHDAY_PHOTOS="cumple/01.jpg,cumple/02.jpg"
# Tarjetas (desde 1) con el texto arriba en vez de abajo, ej: "7" o "3,7"
BIRTHDAY_TEXT_TOP=""
# Canción de fondo (key de R2 o URL a un .mp3)
BIRTHDAY_SONG="cumple/cancion.mp3"
# Título que se muestra arriba, estilo stories de Instagram
BIRTHDAY_SONG_TITLE="Canción · Artista"
# Edad: las velas del pastel toman la forma de estos números
BIRTHDAY_AGE="26"
# Frase de la escena de la luna (si se omite, no se muestra la escena)
BIRTHDAY_MOON_PHRASE="Frase romántica sobre la luna"
# Texto del cupón final, tras "Vale por" (si se omite, no se muestra)
BIRTHDAY_COUPON="un beso"
BIRTHDAY_SIGNATURE="Tu nombre"
